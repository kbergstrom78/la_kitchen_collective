---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout title="Membership | LA Kitchen Collective">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Membership</p>
      <h1>Membership options are coming soon.</h1>

      <p class="lede">
        Membership will be based on kitchen use, storage needs, booking frequency,
        and business stage. Pricing will be posted once details are finalized.
      </p>

      <h2>Members may need</h2>

      <ul class="steps">
        <li>Business registration or license</li>
        <li>Applicable food permit or approval</li>
        <li>Liability insurance</li>
        <li>Food handler or food manager certification, if required</li>
        <li>Signed kitchen agreement</li>
      </ul>
    </div>
  </section>

  <CTA
    heading="Not sure what you’ll need?"
    text="Join the interest list and tell us what kind of food business you’re building."
    buttonText="Join the Interest List"
    buttonHref="/contact"
  />
</BaseLayout>
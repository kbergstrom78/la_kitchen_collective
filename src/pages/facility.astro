---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";

const facilityCards = [
  { title: "Prep space", text: "Shared work areas for food production and packaging." },
  { title: "Cooking equipment", text: "Commercial equipment details coming soon." },
  { title: "Dishwashing & sanitation", text: "Dedicated cleaning and sanitation areas." },
  { title: "Storage", text: "Dry, cold, and freezer storage options depending on availability." },
];
---

<BaseLayout title="Facility | LA Kitchen Collective">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Facility</p>
      <h1>A professional kitchen designed for small food businesses.</h1>

      <p class="lede">
        More details, photos, and equipment lists will be added as the space is finalized.
      </p>

      <CardGrid cards={facilityCards} />
    </div>
  </section>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | LA Kitchen Collective">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Join the interest list.</h1>

      <p class="lede">
        Tell us a little about your food business and we’ll keep you updated as
        the kitchen moves toward opening.
      </p>

      <form class="contact-form" name="interest" method="POST">
        <label>
          Name
          <input type="text" name="name" required />
        </label>

        <label>
          Email
          <input type="email" name="email" required />
        </label>

        <label>
          Business name
          <input type="text" name="business_name" />
        </label>

        <label>
          What kind of food business are you building?
          <textarea name="business_description" rows="5"></textarea>
        </label>

        <button class="button" type="submit">Submit</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-form {
    display: grid;
    gap: 1rem;
    max-width: 640px;
    margin-top: 2rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  button {
    border: 0;
    cursor: pointer;
  }
</style>
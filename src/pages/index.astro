---
import "../styles/global.css";

const currentYear = new Date().getFullYear();

const features = [
  {
    title: "Licensed kitchen space",
    body: "Prep, cooking, and packaging space booked in blocks that fit your production schedule instead of a full-time lease.",
    icon: '<path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/>',
  },
  {
    title: "Commercial equipment",
    body: "Shared equipment sized for real production runs, so a mixer or a hood isn't what stands between you and a wholesale order.",
    icon: '<path d="M2 12h20"/><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"/><path d="m4 8 16-4"/><path d="m8.86 6.78-.45-1.81a2 2 0 0 1 1.45-2.43l1.94-.48a2 2 0 0 1 2.43 1.46l.45 1.8"/>',
  },
  {
    title: "Storage",
    body: "Dry, cold, and frozen storage for ingredients, packaging, and finished product between shifts.",
    icon: '<path d="M5 6a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M5 10h14"/><path d="M15 7v6"/>',
  },
  {
    title: "Business resources",
    body: "Support for the parts that aren't cooking — licensing, food safety plans, operating procedures, and scaling up without breaking what works.",
    icon: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  },
];

const audiences = [
  "Bakers",
  "Caterers",
  "Food trucks & trailers",
  "Packaged foods",
  "Meal prep",
  "Pop-ups & supper clubs",
  "Market vendors",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Los Alamos Kitchen Collective — shared commercial kitchen, opening fall 2027</title>
    <meta
      name="description"
      content="A shared-use commercial kitchen for food entrepreneurs, caterers, bakers, and small food businesses. Opening in Los Alamos County, New Mexico, fall 2027."
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Figtree:wght@400;500;600&display=swap"
    />
  </head>

  <body>
    <main>
      <section class="hero">
        <div>
          <div class="hero__meta">
            <span>Los Alamos County, NM</span>
            <span class="hero__dot"></span>
            <span>Opening fall 2027</span>
          </div>

          <h1>Licensed kitchen space, rented by the hour.</h1>

          <p class="hero__lede">
            The Los Alamos Kitchen Collective is a shared-use commercial kitchen for
            local food entrepreneurs, caterers, bakers, and small food businesses —
            flexible access to licensed space, equipment, storage, and business
            resources, without the cost of building your own facility.
          </p>

          <form
            class="hero-form"
            name="waitlist-hero"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <p class="visually-hidden">
              <label>Don’t fill this out: <input name="bot-field" /></label>
            </p>
            <label class="visually-hidden" for="hero-email">Email address</label>
            <input
              id="hero-email"
              class="input"
              type="email"
              name="email"
              required
              placeholder="you@yourbusiness.com"
            />
            <button class="btn" type="submit">Keep me posted</button>
          </form>

          <p class="hero__note">
            Site secured, permitting underway. Expect occasional updates on
            construction, membership details, and questions we’d like your input on.
          </p>
        </div>

        <div class="hero__mark-wrap">
          <div class="hero__mark">
            <img
              src="/logos/original-version-isologotype.png"
              alt="The Los Alamos Kitchen Collective"
            />
          </div>
        </div>
      </section>

      <section class="status">
        <div class="status__inner">
          <span><strong>Site secured</strong> in Los Alamos County</span>
          <span><strong>In permitting</strong> and design</span>
          <span><strong>Doors open</strong> fall 2027</span>
        </div>
      </section>

      <section class="wrap split">
        <div>
          <h2 class="section-title">For when you outgrow your home kitchen.</h2>
        </div>

        <div class="prose">
          <p>
            New Mexico’s Homemade Food Act is a real on-ramp: shelf-stable foods —
            breads, cookies, granola, dry mixes — can be made in your own kitchen and
            sold without an Environment Department food permit. Plenty of good
            businesses start exactly there.
          </p>
          <p>
            It stops at temperature control. Prepared meals, dairy-based fillings,
            cooked vegetables, refrigerated sauces and dips — anything that needs to be
            held hot or cold for safety — has to be produced in an appropriately
            permitted facility. Building one yourself means a lease, a hood, floor
            drains, and an inspection cycle before you sell a single jar.
          </p>
          <p class="lead-out">
            Prove demand at home, then move production here. That step is what the
            Collective is built for.
          </p>
        </div>
      </section>

      <section class="band-surface">
        <div class="wrap">
          <p class="eyebrow">What members get</p>
          <h2 class="section-title" style="margin-bottom: 56px; max-width: 22em">
            A production kitchen you share instead of finance.
          </h2>

          <div class="features">
            {
              features.map((feature) => (
                <div>
                  <div class="feature__icon">
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="var(--color-accent-700)"
                      stroke-width="2.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={feature.icon}
                    />
                  </div>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>
              ))
            }
          </div>

          <div class="tags">
            <span class="tags__label">Built for:</span>
            {audiences.map((audience) => <span class="tag">{audience}</span>)}
          </div>
        </div>
      </section>

      <section class="band-dark">
        <div class="wrap" style="padding-top: 72px; padding-bottom: 72px">
          <p class="eyebrow">What to expect</p>
          <h2 class="section-title" style="max-width: 20em; margin-bottom: 22px">
            Details are still coming together.
          </h2>
          <p style="font-size: 19px; max-width: 38em">
            The site is secured and we’re working through design and permitting now.
            Join the list and we’ll send membership options, rates, and the opening
            timeline as they’re set.
          </p>
        </div>
      </section>

      <section id="waitlist" class="band-surface">
        <div class="wrap split">
          <div>
            <h2 class="section-title" style="margin-bottom: 22px">Get on the list.</h2>
            <p style="font-size: 19px; color: var(--color-neutral-800); max-width: 26em; margin-bottom: 16px">
              Tell us what you’re making. You’ll get updates as construction moves
              along, membership terms and rates as they’re set, and the occasional
              question about equipment, hours, and how the space should work.
            </p>
            <p style="font-size: 16px; color: var(--color-neutral-700); max-width: 26em">
              The list genuinely shapes how the kitchen gets built. We won’t share your
              address with anyone.
            </p>
          </div>

          <form
            class="waitlist-form"
            name="waitlist"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <p class="visually-hidden">
              <label>Don’t fill this out: <input name="bot-field" /></label>
            </p>

            <div class="field">
              <label for="w-name">Name</label>
              <input id="w-name" class="input" type="text" name="name" required />
            </div>

            <div class="field">
              <label for="w-email">Email</label>
              <input id="w-email" class="input" type="email" name="email" required />
            </div>

            <div class="field">
              <label for="w-type">What are you making?</label>
              <select id="w-type" class="input" name="business_type" required>
                <option value="">Choose one</option>
                <option>Baked goods</option>
                <option>Catering</option>
                <option>Food truck or trailer</option>
                <option>Packaged food or beverage</option>
                <option>Meal prep</option>
                <option>Pop-up or supper club</option>
                <option>Something else</option>
              </select>
            </div>

            <div class="field">
              <label for="w-note">
                Anything we should know? <span>Optional</span>
              </label>
              <textarea
                id="w-note"
                class="input"
                name="note"
                rows="4"
                placeholder="Hours you’d need, equipment you depend on, when you’d want to start."
              ></textarea>
            </div>

            <button class="btn" type="submit">Join the waitlist</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <img src="/logos/sand-logotype.png" alt="The Los Alamos Kitchen Collective" />
        <div class="site-footer__meta">
          <span>Los Alamos County, New Mexico</span>
          <span>Opening fall 2027</span>
          <span>&copy; {currentYear}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

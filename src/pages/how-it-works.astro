---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout title="How It Works | LA Kitchen Collective">
  <section class="section">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h1>From interest to kitchen access.</h1>

      <p class="lede">
        The kitchen will use Food Corridor for member onboarding, scheduling,
        billing, and reservations. This site is here to help you understand
        whether the kitchen is a good fit before you apply.
      </p>

      <ol class="steps">
        <li>Tell us about your food business.</li>
        <li>Schedule a tour or intro conversation.</li>
        <li>Review membership options and kitchen requirements.</li>
        <li>Submit required documents.</li>
        <li>Complete onboarding and book kitchen time through Food Corridor.</li>
      </ol>
    </div>
  </section>

  <CTA
    heading="Want to be notified when we’re ready?"
    text="Join the interest list and we’ll keep you posted as membership details become available."
    buttonText="Join the Interest List"
    buttonHref="/contact"
  />
</BaseLayout>